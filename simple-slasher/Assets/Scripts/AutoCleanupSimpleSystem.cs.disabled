using UnityEngine;

/// <summary>
/// Автоматически удаляет конфликтующие Simple-системы при запуске игры
/// </summary>
public class AutoCleanupSimpleSystem : MonoBehaviour
{
    void Awake()
    {
        int removedCount = 0;

        // Найти и удалить SimpleGameSetup
        GameObject[] simpleGameSetups = GameObject.FindObjectsOfType<SimpleGameSetup>();
        foreach (var setup in simpleGameSetups)
        {
            Debug.Log($"[AutoCleanup] Удаление SimpleGameSetup: {setup.gameObject.name}");
            Destroy(setup);
            removedCount++;
        }

        // Найти и удалить SimpleSceneSetup
        GameObject[] simpleSceneSetups = GameObject.FindObjectsOfType<SimpleSceneSetup>();
        foreach (var setup in simpleSceneSetups)
        {
            Debug.Log($"[AutoCleanup] Удаление SimpleSceneSetup: {setup.gameObject.name}");
            Destroy(setup);
            removedCount++;
        }

        // Найти и удалить SimplePlayerController
        SimplePlayerController[] simplePlayers = GameObject.FindObjectsOfType<SimplePlayerController>();
        foreach (var player in simplePlayers)
        {
            Debug.Log($"[AutoCleanup] Удаление SimplePlayerController: {player.gameObject.name}");
            Destroy(player.gameObject);
            removedCount++;
        }

        // Найти и удалить SimpleAttractSystem
        SimpleAttractSystem[] simpleAttracts = GameObject.FindObjectsOfType<SimpleAttractSystem>();
        foreach (var attract in simpleAttracts)
        {
            Debug.Log($"[AutoCleanup] Удаление SimpleAttractSystem: {attract.gameObject.name}");
            Destroy(attract);
            removedCount++;
        }

        // Найти и удалить SimpleRageSystem
        SimpleRageSystem[] simpleRages = GameObject.FindObjectsOfType<SimpleRageSystem>();
        foreach (var rage in simpleRages)
        {
            Debug.Log($"[AutoCleanup] Удаление SimpleRageSystem: {rage.gameObject.name}");
            Destroy(rage);
            removedCount++;
        }

        if (removedCount > 0)
        {
            Debug.Log($"[AutoCleanup] Удалено {removedCount} конфликтующих Simple-компонентов. CompleteGameSetup теперь будет работать корректно!");
        }

        // Удаляем этот скрипт после выполнения
        Destroy(this);
    }
}