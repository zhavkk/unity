using UnityEngine;
using UnityEditor;

/// <summary>
/// Скрипт для очистки сцены от конфликтующих Simple-систем
/// Запустите этот скрипт через меню: Tools → Cleanup Simple System
/// </summary>
public class CleanupSimpleSystem
{
    [MenuItem("Tools/Cleanup Simple System")]
    public static void Cleanup()
    {
        int removedCount = 0;

        // Найти и удалить SimpleGameSetup (но сначала сохранить имя сцены для Recreation)
        GameObject[] simpleGameSetups = GameObject.FindObjectsOfType<SimpleGameSetup>();
        foreach (var setup in simpleGameSetups)
        {
            Debug.Log($"Удаление SimpleGameSetup: {setup.gameObject.name}");
            GameObject.DestroyImmediate(setup);
            removedCount++;
        }

        // Найти и удалить SimpleSceneSetup
        GameObject[] simpleSceneSetups = GameObject.FindObjectsOfType<SimpleSceneSetup>();
        foreach (var setup in simpleSceneSetups)
        {
            Debug.Log($"Удаление SimpleSceneSetup: {setup.gameObject.name}");
            GameObject.DestroyImmediate(setup);
            removedCount++;
        }

        // Найти и удалить SimplePlayerController
        SimplePlayerController[] simplePlayers = GameObject.FindObjectsOfType<SimplePlayerController>();
        foreach (var player in simplePlayers)
        {
            Debug.Log($"Удаление SimplePlayerController: {player.gameObject.name}");
            GameObject.DestroyImmediate(player.gameObject);
            removedCount++;
        }

        // Найти и удалить SimpleAttractSystem
        SimpleAttractSystem[] simpleAttracts = GameObject.FindObjectsOfType<SimpleAttractSystem>();
        foreach (var attract in simpleAttracts)
        {
            Debug.Log($"Удаление SimpleAttractSystem: {attract.gameObject.name}");
            GameObject.DestroyImmediate(attract);
            removedCount++;
        }

        // Найти и удалить SimpleRageSystem
        SimpleRageSystem[] simpleRages = GameObject.FindObjectsOfType<SimpleRageSystem>();
        foreach (var rage in simpleRages)
        {
            Debug.Log($"Удаление SimpleRageSystem: {rage.gameObject.name}");
            GameObject.DestroyImmediate(rage);
            removedCount++;
        }

        Debug.Log($"=== ОЧИСТКА SIMPLE СИСТЕМ ЗАВЕРШЕНА ===");
        Debug.Log($"Удалено компонентов: {removedCount}");
        Debug.Log($"Теперь CompleteGameSetup будет работать без конфликтов!");

        EditorUtility.DisplayDialog("Очистка завершена",
            $"Удалено {removedCount} конфликтующих Simple-компонентов.\n\nТеперь CompleteGameSetup будет работать без конфликтов!",
            "OK");
    }
}