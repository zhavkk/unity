using UnityEngine;
using UnityEngine.UI;

/// <summary>
/// Полная настройка игровой сцены со всеми необходимыми элементами.
/// Добавьте этот компонент на пустой GameObject в сцене и нажмите Play.
/// </summary>
public class CompleteGameSetup : MonoBehaviour
{
    [Header("Настройки")]
    [SerializeField] private bool autoSetup = true;
    [SerializeField] private bool debugMode = true;

    private void Start()
    {
        // Автоматическая очистка конфликтующих Simple-систем
        CleanupConflictingSystems();

        if (autoSetup)
        {
            SetupCompleteGame();
        }
    }

    private void CleanupConflictingSystems()
    {
        int removedCount = 0;

        // Найти и удалить старых врагов и компоненты которые могут конфликтовать
        GameObject[] enemies = GameObject.FindGameObjectsWithTag("Enemy");
        foreach (var enemy in enemies)
        {
            // Удаляем только врагов без EnemyController (старые Simple враги)
            if (enemy.GetComponent<EnemyController>() == null)
            {
                Debug.Log($"[Cleanup] Удаление старого врага: {enemy.name}");
                Destroy(enemy);
                removedCount++;
            }
        }

        // Найти и удалить старых игроков без EnhancedPlayerController
        GameObject[] players = GameObject.FindGameObjectsWithTag("Player");
        foreach (var player in players)
        {
            if (player.GetComponent<EnhancedPlayerController>() == null)
            {
                Debug.Log($"[Cleanup] Удаление старого игрока: {player.name}");
                Destroy(player);
                removedCount++;
            }
        }

        if (removedCount > 0)
        {
            Debug.Log($"[Cleanup] Удалено {removedCount} старых объектов. CompleteGameSetup теперь будет работать корректно!");
        }
    }

    private void SetupCompleteGame()
    {
        Debug.Log("=== НАЧИНАЕМ ПОЛНУЮ НАСТРОЙКУ ИГРЫ ===");

        // Шаг 0: Создаем менеджеры систем
        CreateSystemManagers();

        // Шаг 1: Создаем слои и теги
        SetupLayersAndTags();

        // Шаг 2: Создаем окружение
        SetupEnvironment();

        // Шаг 3: Создаем игрока
        GameObject player = CreatePlayer();

        // Шаг 4: Создаем шаблон врага
        GameObject enemyTemplate = CreateEnemyTemplate();

        // Шаг 5: Создаем менеджер волн
        GameObject waveManager = CreateWaveManager(player, enemyTemplate);

        // Шаг 6: Настраиваем камеру
        SetupCamera();

        // Шаг 7: Создаем освещение
        SetupLighting();

        // Шаг 8: Создаем UI
        SetupGameUI(player, waveManager);

        Debug.Log("=== НАСТРОЙКА ИГРЫ ЗАВЕРШЕНА ===");
        if (debugMode)
        {
            Debug.Log("Нажмите Play для начала игры!");
            Debug.Log("Управление:");
            Debug.Log("- WASD: Перемещение");
            Debug.Log("- Пробел: Прыжок");
            Debug.Log("- Левый клик / E: Атака");
            Debug.Log("- Правый клик: Притяжение к врагам");
            Debug.Log("- Shift: Спринт");
            Debug.Log("- ESC: Пауза");
        }

        // Отключаем компонент после настройки
        enabled = false;
    }

    private void CreateSystemManagers()
    {
        // Create GameManager first (other systems depend on it)
        GameManager gameManager = FindAnyObjectByType<GameManager>();
        if (gameManager == null)
        {
            GameObject gameManagerObj = new GameObject("GameManager");
            gameManagerObj.AddComponent<GameManager>();
            Debug.Log("✅ GameManager создан");
        }
        else
        {
            Debug.Log("ℹ️ GameManager уже существует");
        }

        // Create VFX Manager
        VFXManager vfxManager = FindAnyObjectByType<VFXManager>();
        if (vfxManager == null)
        {
            GameObject vfxObj = new GameObject("VFXManager");
            vfxObj.AddComponent<VFXManager>();
            Debug.Log("✅ VFXManager создан");
        }
        else
        {
            Debug.Log("ℹ️ VFXManager уже существует");
        }

        // Create Combo System
        ComboSystem comboSystem = FindAnyObjectByType<ComboSystem>();
        if (comboSystem == null)
        {
            GameObject comboObj = new GameObject("ComboSystem");
            comboObj.AddComponent<ComboSystem>();
            Debug.Log("✅ ComboSystem создан");
        }
        else
        {
            Debug.Log("ℹ️ ComboSystem уже существует");
        }

        // Create Floating Text Manager
        FloatingTextManager textManager = FindAnyObjectByType<FloatingTextManager>();
        if (textManager == null)
        {
            GameObject textObj = new GameObject("FloatingTextManager");
            textObj.AddComponent<FloatingTextManager>();
            Debug.Log("✅ FloatingTextManager создан");
        }
        else
        {
            Debug.Log("ℹ️ FloatingTextManager уже существует");
        }

        // Create Game Menu Manager
        GameMenuManager menuManager = FindAnyObjectByType<GameMenuManager>();
        if (menuManager == null)
        {
            GameObject menuObj = new GameObject("GameMenuManager");
            menuObj.AddComponent<GameMenuManager>();
            Debug.Log("✅ GameMenuManager создан");
        }
        else
        {
            Debug.Log("ℹ️ GameMenuManager уже существует");
        }

        // Create Upgrade System
        UpgradeSystem upgradeSystem = FindAnyObjectByType<UpgradeSystem>();
        if (upgradeSystem == null)
        {
            GameObject upgradeObj = new GameObject("UpgradeSystem");
            upgradeObj.AddComponent<UpgradeSystem>();
            Debug.Log("✅ UpgradeSystem создан");
        }
        else
        {
            Debug.Log("ℹ️ UpgradeSystem уже существует");
        }
    }

    private void SetupLayersAndTags()
    {
        // Проверяем и создаем слой Enemy
        int enemyLayer = LayerMask.NameToLayer("Enemy");
        if (enemyLayer == -1)
        {
            Debug.LogWarning("Слой Enemy не найден. Используем слой 6.");
        }
        else
        {
            Debug.Log("✅ Слой Enemy найден: " + enemyLayer);
        }
    }

    private void SetLayerRecursively(GameObject obj, int layer)
    {
        obj.layer = layer;
        foreach (Transform child in obj.transform)
        {
            SetLayerRecursively(child.gameObject, layer);
        }
    }

    private void SetupEnvironment()
    {
        // Проверяем, существует ли земля
        GameObject existingGround = GameObject.Find("Ground");
        if (existingGround != null)
        {
            Debug.Log("ℹ️ Земля уже существует");
            return;
        }

        // Создаем землю
        GameObject ground = GameObject.CreatePrimitive(PrimitiveType.Plane);
        ground.name = "Ground";
        ground.transform.position = Vector3.zero;
        ground.transform.localScale = new Vector3(30, 1, 30);

        // Создаем материал для земли
        Material groundMaterial = new Material(Shader.Find("Standard"));
        groundMaterial.color = new Color(0.15f, 0.3f, 0.15f); // Темно-зеленый для лучшей контрастности
        groundMaterial.SetFloat("_Glossiness", 0.3f);
        Renderer groundRenderer = ground.GetComponent<Renderer>();
        if (groundRenderer != null)
        {
            groundRenderer.material = groundMaterial;
        }

        Debug.Log("✅ Окружение создано");
    }

    private GameObject CreatePlayer()
    {
        // Проверяем, существует ли игрок
        GameObject existingPlayer = GameObject.FindWithTag("Player");
        if (existingPlayer != null)
        {
            Debug.Log("ℹ️ Игрок уже существует");
            return existingPlayer;
        }

        // Создаем контейнер игрока
        GameObject player = new GameObject("Player");
        player.tag = "Player";
        player.layer = LayerMask.NameToLayer("Default");
        player.transform.position = new Vector3(0, 1, 0);

        // Добавляем детализированную модель игрока God of War (Ultimate Kratos)
        GameObject playerModel = KratosModelGenerator.CreateUltimateKratosModel();
        playerModel.transform.SetParent(player.transform);
        playerModel.transform.localPosition = Vector3.zero;

        // Устанавливаем правильный слой для модели игрока
        SetLayerRecursively(playerModel, player.layer);

        // Добавляем Character Controller
        CharacterController charController = player.AddComponent<CharacterController>();
        charController.height = 2f;
        charController.radius = 0.5f;
        charController.slopeLimit = 45f;
        charController.stepOffset = 0.3f;
        charController.skinWidth = 0.08f;
        charController.minMoveDistance = 0f;
        charController.center = new Vector3(0, 1, 0);

        // Создаем точку атаки
        GameObject attackPoint = new GameObject("AttackPoint");
        attackPoint.transform.SetParent(player.transform);
        attackPoint.transform.localPosition = new Vector3(0, 1f, 1.5f);

        // Добавляем компоненты игрока
        EnhancedPlayerController playerController = player.AddComponent<EnhancedPlayerController>();
        ConfigurePlayerController(playerController, attackPoint.transform);

        PlayerAttract playerAttract = player.AddComponent<PlayerAttract>();
        ConfigurePlayerAttract(playerAttract);

        RageSystem rageSystem = player.AddComponent<RageSystem>();
        ConfigureRageSystem(rageSystem);

        if (playerController != null && rageSystem != null)
        {
            // Подключаем событие атаки к системе ярости
            var onPlayerAttackEvent = typeof(EnhancedPlayerController).GetEvent("OnPlayerAttack",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (onPlayerAttackEvent != null)
            {
                var onPlayerAttackMethod = typeof(RageSystem).GetMethod("OnPlayerAttack",
                    System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
                if (onPlayerAttackMethod != null)
                {
                    onPlayerAttackEvent.AddEventHandler(playerController,
                        System.Delegate.CreateDelegate(onPlayerAttackEvent.EventHandlerType, rageSystem, onPlayerAttackMethod));
                    Debug.Log("✅ Событие атаки подключено к системе ярости");
                }
            }
        }

        PlayerHealth playerHealth = player.AddComponent<PlayerHealth>();
        GameIntegrator gameIntegrator = player.AddComponent<GameIntegrator>();

        Debug.Log("✅ Игрок создан");
        return player;
    }

    private void ConfigurePlayerController(EnhancedPlayerController controller, Transform attackPoint)
    {
        var controllerType = typeof(EnhancedPlayerController);
        var attackPointField = controllerType.GetField("attackPoint",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (attackPointField != null)
        {
            attackPointField.SetValue(controller, attackPoint);
        }

        var attackRangeField = controllerType.GetField("attackRange",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (attackRangeField != null)
        {
            attackRangeField.SetValue(controller, 2f);
        }

        var enemyLayerField = controllerType.GetField("enemyLayer",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (enemyLayerField != null)
        {
            enemyLayerField.SetValue(controller, (LayerMask)(1 << LayerMask.NameToLayer("Enemy")));
        }
    }

    private void ConfigurePlayerAttract(PlayerAttract attract)
    {
        var attractType = typeof(PlayerAttract);
        var enemyLayerField = attractType.GetField("enemyLayer",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (enemyLayerField != null)
        {
            enemyLayerField.SetValue(attract, (LayerMask)(1 << LayerMask.NameToLayer("Enemy")));
        }
    }

    private void ConfigureRageSystem(RageSystem rageSystem)
    {
        // Система ярости уже настроена через инспектор
    }

    private GameObject CreateEnemyTemplate()
    {
        // Создаем объект врага
        GameObject enemy = new GameObject("Enemy");

        // Добавляем детализированную модель врага God of War (Draugr)
        GameObject enemyModel = EnhancedModelGenerator.CreateGodOfWarEnemyModel();
        enemyModel.transform.SetParent(enemy.transform);
        enemyModel.transform.localPosition = Vector3.zero;

        // Добавляем коллайдер
        CapsuleCollider collider = enemy.AddComponent<CapsuleCollider>();
        collider.height = 3.5f; // Увеличено для больших моделей
        collider.radius = 0.8f; // Увеличено для больших моделей
        collider.center = new Vector3(0, 1.75f, 0); // Увеличено для больших моделей

        // Добавляем Rigidbody
        Rigidbody rb = enemy.AddComponent<Rigidbody>();
        rb.mass = 1f;
        rb.linearDamping = 0f;
        rb.angularDamping = 0.05f;
        rb.useGravity = true;
        rb.isKinematic = false;
        rb.constraints = RigidbodyConstraints.FreezeRotationX | RigidbodyConstraints.FreezeRotationY | RigidbodyConstraints.FreezeRotationZ;

        // Добавляем компоненты врага
        EnemyHealth enemyHealth = enemy.AddComponent<EnemyHealth>();
        var healthType = typeof(EnemyHealth);
        var maxHealthField = healthType.GetField("maxHealth",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (maxHealthField != null)
        {
            maxHealthField.SetValue(enemyHealth, 30f);
        }

        EnemyController enemyController = enemy.AddComponent<EnemyController>();
        var controllerType = typeof(EnemyController);
        var damageField = controllerType.GetField("damage",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (damageField != null)
        {
            damageField.SetValue(enemyController, 10f);
        }

        var moveSpeedField = controllerType.GetField("moveSpeed",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (moveSpeedField != null)
        {
            moveSpeedField.SetValue(enemyController, 2.5f);
        }

        // Устанавливаем тег и слой
        enemy.tag = "Enemy";
        int enemyLayer = LayerMask.NameToLayer("Enemy");
        if (enemyLayer == -1)
        {
            enemy.layer = 6; // Fallback
        }
        else
        {
            enemy.layer = enemyLayer;
        }

        Debug.Log("✅ Шаблон врага создан");
        return enemy;
    }

    private GameObject CreateWaveManager(GameObject player, GameObject enemyTemplate)
    {
        // Проверяем, существует ли WaveManager
        WaveManager[] existingManagers = Object.FindObjectsByType<WaveManager>();
        if (existingManagers != null && existingManagers.Length > 0)
        {
            Debug.Log("ℹ️ WaveManager уже существует");
            return existingManagers[0].gameObject;
        }

        // Создаем WaveManager
        GameObject waveManagerObj = new GameObject("WaveManager");
        WaveManager waveManager = waveManagerObj.AddComponent<WaveManager>();

        // Настраиваем параметры через рефлексию
        var managerType = typeof(WaveManager);
        var playerTransformField = managerType.GetField("playerTransform",
            System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
        if (playerTransformField != null)
        {
            playerTransformField.SetValue(waveManager, player.transform);
        }

        var enemyPrefabField = managerType.GetField("enemyPrefab",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (enemyPrefabField != null)
        {
            enemyPrefabField.SetValue(waveManager, enemyTemplate);
        }

        var startingEnemiesField = managerType.GetField("startingEnemies",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (startingEnemiesField != null)
        {
            startingEnemiesField.SetValue(waveManager, 3);
        }

        var enemiesPerWaveIncreaseField = managerType.GetField("enemiesPerWaveIncrease",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (enemiesPerWaveIncreaseField != null)
        {
            enemiesPerWaveIncreaseField.SetValue(waveManager, 2);
        }

        var waveDelayField = managerType.GetField("waveDelay",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (waveDelayField != null)
        {
            waveDelayField.SetValue(waveManager, 5f);
        }

        var minSpawnDistanceField = managerType.GetField("minSpawnDistance",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (minSpawnDistanceField != null)
        {
            minSpawnDistanceField.SetValue(waveManager, 10f);
        }

        var maxSpawnDistanceField = managerType.GetField("maxSpawnDistance",
            System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
        if (maxSpawnDistanceField != null)
        {
            maxSpawnDistanceField.SetValue(waveManager, 20f);
        }

        // Start the wave system after everything is set up
        waveManager.StartWaves();

        Debug.Log("✅ WaveManager создан");
        return waveManagerObj;
    }

    private void SetupCamera()
    {
        // Ищем существующую камеру
        Camera mainCamera = Camera.main;
        GameObject cameraObj = null;

        if (mainCamera == null)
        {
            cameraObj = new GameObject("MainCamera");
            cameraObj.tag = "MainCamera";
            mainCamera = cameraObj.AddComponent<Camera>();
            cameraObj.AddComponent<AudioListener>();
            Debug.Log("✅ Главная камера создана");
        }
        else
        {
            cameraObj = mainCamera.gameObject;
            Debug.Log("ℹГлавная камера уже существует");
        }

        // Настраиваем камеру
        cameraObj.transform.position = new Vector3(0, 8, -12);
        cameraObj.transform.rotation = Quaternion.Euler(25, 0, 0);

        // Добавляем Camera Follow
        CameraFollow cameraFollow = cameraObj.GetComponent<CameraFollow>();
        if (cameraFollow == null)
        {
            cameraFollow = cameraObj.AddComponent<CameraFollow>();
        }

        Debug.Log("✅ Камера настроена");
    }

    private void SetupLighting()
    {
        // Проверяем, существует ли свет
        Light[] existingLights = Object.FindObjectsByType<Light>();
        if (existingLights != null && existingLights.Length > 0)
        {
            Debug.Log("ℹ️ Освещение уже существует");
            return;
        }

        // Создаем направленный свет
        GameObject lightObj = new GameObject("DirectionalLight");
        lightObj.transform.position = new Vector3(10, 15, 0);
        lightObj.transform.rotation = Quaternion.Euler(45, -30, 0);

        Light light = lightObj.AddComponent<Light>();
        light.type = LightType.Directional;
        light.intensity = 1.2f;
        light.shadows = LightShadows.Soft;
        light.shadowStrength = 0.7f;

        // Создаем дополнительное освещение
        GameObject fillLightObj = new GameObject("FillLight");
        fillLightObj.transform.position = new Vector3(-5, 10, 5);
        fillLightObj.transform.rotation = Quaternion.Euler(30, 45, 0);

        Light fillLight = fillLightObj.AddComponent<Light>();
        fillLight.type = LightType.Directional;
        fillLight.intensity = 0.3f;
        fillLight.color = new Color(0.8f, 0.9f, 1.0f);

        Debug.Log("✅ Освещение создано");
    }

    private void SetupGameUI(GameObject player, GameObject waveManager)
    {
        // Ищем существующий Canvas
        Canvas[] existingCanvases = Object.FindObjectsByType<Canvas>();
        Canvas canvas;

        if (existingCanvases != null && existingCanvases.Length > 0)
        {
            canvas = existingCanvases[0];
            Debug.Log("ℹ️ Canvas уже существует");
        }
        else
        {
            // Создаем Canvas
            GameObject canvasObj = new GameObject("GameCanvas");
            canvas = canvasObj.AddComponent<Canvas>();
            canvas.renderMode = RenderMode.ScreenSpaceOverlay;
            canvasObj.AddComponent<CanvasScaler>();
            canvasObj.AddComponent<GraphicRaycaster>();
            Debug.Log("✅ Canvas создан");
        }

        // Создаем панель здоровья игрока
        CreatePlayerHealthPanel(canvas, player);

        // Создаем панель ярости
        CreateRagePanel(canvas, player);

        // Создаем панель информации о волнах
        CreateWaveInfoPanel(canvas, waveManager);

        // Создаем панель счета и комбо
        CreateScoreAndComboPanel(canvas);

        // Создаем инструкции
        CreateInstructionsPanel(canvas);

        // Создаем систему помощи по управлению
        // CreateControlHelp(canvas) /* Disabled */;

        Debug.Log("✅ Игровой UI создан");
    }

    private void CreatePlayerHealthPanel(Canvas canvas, GameObject player)
    {
        GameObject healthPanel = new GameObject("HealthPanel");
        healthPanel.transform.SetParent(canvas.transform);

        RectTransform panelRect = healthPanel.AddComponent<RectTransform>();
        panelRect.anchorMin = new Vector2(0, 0);
        panelRect.anchorMax = new Vector2(0, 0);
        panelRect.pivot = new Vector2(0, 0);
        panelRect.anchoredPosition = new Vector2(20, 20);
        panelRect.sizeDelta = new Vector2(200, 30);

        Image panelImage = healthPanel.AddComponent<Image>();
        panelImage.color = new Color(0, 0, 0, 0.5f);

        // Заголовок
        GameObject titleObj = new GameObject("HealthTitle");
        titleObj.transform.SetParent(healthPanel.transform);
        RectTransform titleRect = titleObj.AddComponent<RectTransform>();
        titleRect.anchorMin = Vector2.zero;
        titleRect.anchorMax = Vector2.one;
        titleRect.sizeDelta = Vector2.zero;

        Text titleText = titleObj.AddComponent<Text>();
        titleText.text = "HP";
        titleText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        titleText.fontSize = 14;
        titleText.alignment = TextAnchor.MiddleLeft;
        titleText.color = Color.white;

        // Полоска здоровья
        GameObject healthBarObj = new GameObject("HealthBar");
        healthBarObj.transform.SetParent(healthPanel.transform);
        RectTransform healthBarRect = healthBarObj.AddComponent<RectTransform>();
        healthBarRect.anchorMin = new Vector2(0.3f, 0.2f);
        healthBarRect.anchorMax = new Vector2(0.95f, 0.8f);
        healthBarRect.sizeDelta = Vector2.zero;

        Image healthBarImage = healthBarObj.AddComponent<Image>();
        healthBarImage.color = Color.green;
        healthBarImage.type = Image.Type.Filled;
        healthBarImage.fillMethod = Image.FillMethod.Horizontal;
        healthBarImage.fillAmount = 1f;

        // Подключаем к PlayerHealth
        PlayerHealth playerHealth = player.GetComponent<PlayerHealth>();
        if (playerHealth != null)
        {
            // Создаем компонент для обновления UI
            HealthUIUpdater healthUpdater = healthBarObj.AddComponent<HealthUIUpdater>();
            healthUpdater.Initialize(healthBarImage, playerHealth);
        }
    }

    private void CreateRagePanel(Canvas canvas, GameObject player)
    {
        GameObject ragePanel = new GameObject("RagePanel");
        ragePanel.transform.SetParent(canvas.transform);

        RectTransform panelRect = ragePanel.AddComponent<RectTransform>();
        panelRect.anchorMin = new Vector2(0, 0);
        panelRect.anchorMax = new Vector2(0, 0);
        panelRect.pivot = new Vector2(0, 0);
        panelRect.anchoredPosition = new Vector2(20, 60);
        panelRect.sizeDelta = new Vector2(200, 30);

        Image panelImage = ragePanel.AddComponent<Image>();
        panelImage.color = new Color(0, 0, 0, 0.5f);

        // Заголовок
        GameObject titleObj = new GameObject("RageTitle");
        titleObj.transform.SetParent(ragePanel.transform);
        RectTransform titleRect = titleObj.AddComponent<RectTransform>();
        titleRect.anchorMin = Vector2.zero;
        titleRect.anchorMax = Vector2.one;
        titleRect.sizeDelta = Vector2.zero;

        Text titleText = titleObj.AddComponent<Text>();
        titleText.text = "RAGE";
        titleText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        titleText.fontSize = 14;
        titleText.alignment = TextAnchor.MiddleLeft;
        titleText.color = Color.red;

        // Полоска ярости
        GameObject rageBarObj = new GameObject("RageBar");
        rageBarObj.transform.SetParent(ragePanel.transform);
        RectTransform rageBarRect = rageBarObj.AddComponent<RectTransform>();
        rageBarRect.anchorMin = new Vector2(0.3f, 0.2f);
        rageBarRect.anchorMax = new Vector2(0.95f, 0.8f);
        rageBarRect.sizeDelta = Vector2.zero;

        Image rageBarImage = rageBarObj.AddComponent<Image>();
        rageBarImage.color = Color.red;
        rageBarImage.type = Image.Type.Filled;
        rageBarImage.fillMethod = Image.FillMethod.Horizontal;
        rageBarImage.fillAmount = 0f;

        // Подключаем к RageSystem
        RageSystem rageSystem = player.GetComponent<RageSystem>();
        if (rageSystem != null)
        {
            // Простой апдейтер для Image-полоски
            if (rageBarObj.GetComponent<RageUIUpdater>() == null)
            {
                RageUIUpdater updater = rageBarObj.AddComponent<RageUIUpdater>();
                updater.Initialize(rageBarImage, rageSystem);
            }

            // (опционально) совместимость со старой реализацией RageSystem, где могло быть поле rageFill
            var rageSystemType = typeof(RageSystem);
            var rageFillField = rageSystemType.GetField(
                "rageFill",
                System.Reflection.BindingFlags.NonPublic | System.Reflection.BindingFlags.Instance);
            if (rageFillField != null)
            {
                rageFillField.SetValue(rageSystem, rageBarImage);
            }
        }
    }

    private void CreateWaveInfoPanel(Canvas canvas, GameObject waveManager)
    {
        GameObject wavePanel = new GameObject("WavePanel");
        wavePanel.transform.SetParent(canvas.transform);

        RectTransform panelRect = wavePanel.AddComponent<RectTransform>();
        panelRect.anchorMin = new Vector2(1, 1);
        panelRect.anchorMax = new Vector2(1, 1);
        panelRect.pivot = new Vector2(1, 1);
        panelRect.anchoredPosition = new Vector2(-20, -20);
        panelRect.sizeDelta = new Vector2(250, 80);

        Image panelImage = wavePanel.AddComponent<Image>();
        panelImage.color = new Color(0, 0, 0, 0.5f);

        // Текст волны
        GameObject waveTextObj = new GameObject("WaveText");
        waveTextObj.transform.SetParent(wavePanel.transform);
        RectTransform waveTextRect = waveTextObj.AddComponent<RectTransform>();
        waveTextRect.anchorMin = new Vector2(0, 0.5f);
        waveTextRect.anchorMax = new Vector2(1, 1);
        waveTextRect.sizeDelta = new Vector2(-10, -5);

        Text waveText = waveTextObj.AddComponent<Text>();
        waveText.text = "Волна: 1";
        waveText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        waveText.fontSize = 20;
        waveText.alignment = TextAnchor.MiddleCenter;
        waveText.color = Color.white;

        // Текст врагов
        GameObject enemiesTextObj = new GameObject("EnemiesText");
        enemiesTextObj.transform.SetParent(wavePanel.transform);
        RectTransform enemiesTextRect = enemiesTextObj.AddComponent<RectTransform>();
        enemiesTextRect.anchorMin = new Vector2(0, 0);
        enemiesTextRect.anchorMax = new Vector2(1, 0.5f);
        enemiesTextRect.sizeDelta = new Vector2(-10, -5);

        Text enemiesText = enemiesTextObj.AddComponent<Text>();
        enemiesText.text = "Врагов: 0";
        enemiesText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        enemiesText.fontSize = 16;
        enemiesText.alignment = TextAnchor.MiddleCenter;
        enemiesText.color = Color.yellow;

        // Подключаем к WaveManager
        WaveManager manager = waveManager.GetComponent<WaveManager>();
        if (manager != null)
        {
            var managerType = typeof(WaveManager);
            var waveCounterTextField = managerType.GetField("waveCounterText",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (waveCounterTextField != null)
            {
                waveCounterTextField.SetValue(manager, waveText);
            }

            var enemiesRemainingTextField = managerType.GetField("enemiesRemainingText",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (enemiesRemainingTextField != null)
            {
                enemiesRemainingTextField.SetValue(manager, enemiesText);
            }
        }
    }

    private void CreateInstructionsPanel(Canvas canvas)
    {
        GameObject instructionsPanel = new GameObject("InstructionsPanel");
        instructionsPanel.transform.SetParent(canvas.transform);

        RectTransform panelRect = instructionsPanel.AddComponent<RectTransform>();
        panelRect.anchorMin = new Vector2(0.5f, 0);
        panelRect.anchorMax = new Vector2(0.5f, 0);
        panelRect.pivot = new Vector2(0.5f, 0);
        panelRect.anchoredPosition = new Vector2(0, 20);
        panelRect.sizeDelta = new Vector2(400, 60);

        Image panelImage = instructionsPanel.AddComponent<Image>();
        panelImage.color = new Color(0, 0, 0, 0.3f);

        GameObject textObj = new GameObject("InstructionsText");
        textObj.transform.SetParent(instructionsPanel.transform);
        RectTransform textRect = textObj.AddComponent<RectTransform>();
        textRect.anchorMin = Vector2.zero;
        textRect.anchorMax = Vector2.one;
        textRect.sizeDelta = new Vector2(-10, -10);

        Text instructionsText = textObj.AddComponent<Text>();
        instructionsText.text = "WASD: Движение | ЛКМ: Атака | ПКМ: Притяжение | SHIFT: Спринт | SPACE: Прыжок | ESC: Пауза";
        instructionsText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        instructionsText.fontSize = 12;
        instructionsText.alignment = TextAnchor.MiddleCenter;
        instructionsText.color = Color.white;
    }

    private void CreateScoreAndComboPanel(Canvas canvas)
    {
        GameObject scorePanel = new GameObject("ScoreAndComboPanel");
        scorePanel.transform.SetParent(canvas.transform);

        RectTransform panelRect = scorePanel.AddComponent<RectTransform>();
        panelRect.anchorMin = new Vector2(0.5f, 1);
        panelRect.anchorMax = new Vector2(0.5f, 1);
        panelRect.pivot = new Vector2(0.5f, 1);
        panelRect.anchoredPosition = new Vector2(0, -20);
        panelRect.sizeDelta = new Vector2(300, 100);

        // Score text
        GameObject scoreObj = new GameObject("ScoreText");
        scoreObj.transform.SetParent(scorePanel.transform);
        RectTransform scoreRect = scoreObj.AddComponent<RectTransform>();
        scoreRect.anchorMin = new Vector2(0, 0.6f);
        scoreRect.anchorMax = new Vector2(1, 1);
        scoreRect.sizeDelta = new Vector2(-10, -5);

        Text scoreText = scoreObj.AddComponent<Text>();
        scoreText.text = "Score: 0";
        scoreText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        scoreText.fontSize = 24;
        scoreText.alignment = TextAnchor.MiddleCenter;
        scoreText.color = Color.white;
        scoreText.fontStyle = FontStyle.Bold;

        // Combo text
        GameObject comboObj = new GameObject("ComboText");
        comboObj.transform.SetParent(scorePanel.transform);
        RectTransform comboRect = comboObj.AddComponent<RectTransform>();
        comboRect.anchorMin = new Vector2(0, 0.3f);
        comboRect.anchorMax = new Vector2(1, 0.6f);
        comboRect.sizeDelta = new Vector2(-10, -5);

        Text comboText = comboObj.AddComponent<Text>();
        comboText.text = "";
        comboText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        comboText.fontSize = 20;
        comboText.alignment = TextAnchor.MiddleCenter;
        comboText.color = Color.yellow;
        comboText.fontStyle = FontStyle.Bold;

        // Multiplier text
        GameObject multiplierObj = new GameObject("MultiplierText");
        multiplierObj.transform.SetParent(scorePanel.transform);
        RectTransform multiplierRect = multiplierObj.AddComponent<RectTransform>();
        multiplierRect.anchorMin = new Vector2(0, 0);
        multiplierRect.anchorMax = new Vector2(1, 0.3f);
        multiplierRect.sizeDelta = new Vector2(-10, -5);

        Text multiplierText = multiplierObj.AddComponent<Text>();
        multiplierText.text = "";
        multiplierText.font = Resources.GetBuiltinResource<Font>("LegacyRuntime.ttf");
        multiplierText.fontSize = 16;
        multiplierText.alignment = TextAnchor.MiddleCenter;
        multiplierText.color = Color.cyan;

        // Connect to ComboSystem
        ComboSystem comboSystem = FindAnyObjectByType<ComboSystem>();
        if (comboSystem != null)
        {
            var comboType = typeof(ComboSystem);
            var scoreTextField = comboType.GetField("scoreText",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (scoreTextField != null)
            {
                scoreTextField.SetValue(comboSystem, scoreText);
            }

            var comboTextField = comboType.GetField("comboText",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (comboTextField != null)
            {
                comboTextField.SetValue(comboSystem, comboText);
            }

            var multiplierTextField = comboType.GetField("multiplierText",
                System.Reflection.BindingFlags.Public | System.Reflection.BindingFlags.Instance);
            if (multiplierTextField != null)
            {
                multiplierTextField.SetValue(comboSystem, multiplierText);
            }
        }
    }
}

/// <summary>
/// Компонент для обновления UI здоровья игрока.
/// </summary>
public class HealthUIUpdater : MonoBehaviour
{
    private Image healthBar;
    private PlayerHealth playerHealth;
    private float maxHealth;

    public void Initialize(Image bar, PlayerHealth health)
    {
        healthBar = bar;
        playerHealth = health;
        maxHealth = health.GetMaxHealth();
    }

    private void Update()
    {
        if (healthBar != null && playerHealth != null)
        {
            float currentHealth = playerHealth.GetCurrentHealth();
            healthBar.fillAmount = Mathf.Clamp01(currentHealth / maxHealth);

            // Меняем цвет в зависимости от здоровья
            if (currentHealth < maxHealth * 0.3f)
            {
                healthBar.color = Color.red;
            }
            else if (currentHealth < maxHealth * 0.6f)
            {
                healthBar.color = Color.yellow;
            }
            else
            {
                healthBar.color = Color.green;
            }
        }
    }
}
/// <summary>
/// Компонент для обновления UI ярости игрока (простая Image-полоска).
/// </summary>
public class RageUIUpdater : MonoBehaviour
{
    private UnityEngine.UI.Image rageBar;
    private RageSystem rageSystem;

    public void Initialize(UnityEngine.UI.Image bar, RageSystem system)
    {
        rageBar = bar;
        rageSystem = system;
    }

    private void Update()
    {
        if (rageBar == null || rageSystem == null) return;

        float max = Mathf.Max(0.0001f, rageSystem.GetMaxRage());
        float current = rageSystem.GetCurrentRage();
        rageBar.fillAmount = Mathf.Clamp01(current / max);

        // Небольшой градиент для читаемости
        rageBar.color = Color.Lerp(Color.white, new Color(1f, 0.3f, 0f), rageBar.fillAmount);
    }
}
