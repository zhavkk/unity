using UnityEngine;
using UnityEditor;

/// <summary>
/// Принудительная полная очистка сцены и перезапуск CompleteGameSetup
/// Запустите через меню: Tools → Force Clean Reset
/// </summary>
public class ForceCleanReset
{
    [MenuItem("Tools/Force Clean Reset")]
    public static void ForceCleanup()
    {
        int removedCount = 0;

        // Удалим ВСЕ GameObjects кроме основных Unity объектов
        GameObject[] allObjects = GameObject.FindObjectsOfType<GameObject>();

        foreach (GameObject obj in allObjects)
        {
            // Не удаляем Unity объекты
            if (obj.name.Contains("MainCamera") && obj.tag == "MainCamera")
            {
                continue; // Сохраняем главную камеру
            }

            // Удаляем всё остальное
            Debug.Log($"[ForceCleanup] Удаление: {obj.name}");
            DestroyImmediate(obj);
            removedCount++;
        }

        // Создаем чистый CompleteGameSetup объект
        GameObject setupObj = new GameObject("CompleteGameSetup");
        setupObj.AddComponent<CompleteGameSetup>();

        Debug.Log($"=== ПРИНУДИТЕЛЬНАЯ ОЧИСТКА ЗАВЕРШЕНА ===");
        Debug.Log($"Удалено объектов: {removedCount}");
        Debug.Log($"Создан новый CompleteGameSetup. Запустите сцену!");

        EditorUtility.DisplayDialog("Очистка завершена",
            $"Удалено {removedCount} объектов.\n\nСоздан новый CompleteGameSetup. Запустите сцену для начала игры!",
            "OK");
    }
}